---
import Base from "../../layouts/Base.astro";
import PostList from "../../components/PostList.astro";
import { getPosts } from "../../lib/posts";

const posts = await getPosts();
---

<Base
  title="Blog"
  description="Long-form notes from Aaron Santo on the nerdy parts of his projects: Kubernetes homelabs, BGP, Go audio pipelines and dotfiles."
>
  <div class="mx-auto max-w-3xl px-4 pt-16 sm:px-6 sm:pt-20">
    <header>
      <p class="font-mono text-sm text-comment">
        <span class="text-green">❯</span> cat ~/notes/*.md
      </p>
      <h1 class="mt-3 text-4xl font-bold tracking-tight text-fg">Blog</h1>
      <p class="mt-4 text-lg leading-relaxed text-fg-muted">
        Deep dives into the projects I can't stop tinkering with. Expect war
        stories, measurements and more code than strictly necessary.
        <a href="/rss.xml" class="font-mono text-sm text-blue hover:underline">
          rss
        </a>
      </p>
    </header>
    <div class="mt-10">
      <PostList posts={posts} />
    </div>
  </div>
</Base>

---
import { codeToTokens } from "shiki";
import Base from "../layouts/Base.astro";
import HeroCode from "../components/HeroCode.svelte";
import ProjectCard from "../components/ProjectCard.astro";
import PostList from "../components/PostList.astro";
import SectionHeading from "../components/SectionHeading.astro";
import { projects } from "../data/projects";
import { site } from "../data/site";
import { getPosts } from "../lib/posts";
import konamiSource from "../lib/konami.ts?raw";

const ITALIC = 1;

const { tokens } = await codeToTokens(konamiSource.trimEnd(), {
  lang: "ts",
  theme: "kanagawa-dragon",
});
const lines = tokens.map((line) =>
  line.map((token) => ({
    content: token.content,
    color: token.color,
    italic: ((token.fontStyle ?? 0) & ITALIC) !== 0,
  })),
);

const featured = projects.filter((project) => project.featured);
const posts = (await getPosts()).slice(0, 4);

const now = [
  {
    when: "sep 2026",
    what: "Shipped a four-track soundboard in discord-audio-streamer 1.3",
  },
  {
    when: "aug 2026",
    what: "Pinned Ceph after Renovate tried to upgrade me to a release candidate",
  },
  {
    when: "aug 2026",
    what: "Moved the apps' databases from SQLite to CloudNativePG",
  },
  {
    when: "jul 2026",
    what: "Rebuilt the homelab around Flux, SOPS and Renovate",
  },
];
---

<Base>
  <noscript>
    <style>
      .hero-code .pending {
        visibility: visible;
      }
    </style>
  </noscript>

  <section class="relative isolate overflow-hidden">
    <div
      class="absolute inset-0 -z-10 bg-[radial-gradient(ellipse_at_top_right,var(--c-glow),transparent_60%)]"
      aria-hidden="true"
    ></div>
    <div
      class="absolute inset-0 -z-10 [background-image:radial-gradient(var(--c-line)_1px,transparent_1px)] [background-size:22px_22px] [mask-image:linear-gradient(to_bottom,black,transparent_85%)] opacity-60"
      aria-hidden="true"
    ></div>

    <div class="mx-auto grid max-w-5xl items-center gap-12 px-4 pt-16 pb-20 sm:px-6 sm:pt-24 lg:grid-cols-[1fr_1.3fr] lg:gap-10">
      <div>
        <p class="font-mono text-sm text-comment">
          <span class="text-green">❯</span> whoami
        </p>
        <h1 class="mt-3 text-4xl font-bold tracking-tight text-fg sm:text-6xl">
          Aaron Santo
        </h1>
        <p class="mt-2 font-mono text-base text-purple sm:text-lg">
          // aka Lil Strudel
        </p>
        <p class="mt-6 max-w-md text-lg leading-relaxed text-fg-muted">
          DevOps engineer by day, software developer by night. I write a lot of
          infrastructure as code, run a six-node Kubernetes cluster at home and
          build things in whatever language the problem wants.
        </p>
        <div class="mt-8 flex flex-wrap items-center gap-3 font-mono text-sm">
          <a
            href="/blog"
            class="rounded-lg bg-blue px-4 py-2 font-semibold text-bg transition-opacity hover:opacity-90"
          >
            read the blog
          </a>
          <a
            href="/projects"
            class="rounded-lg border border-line px-4 py-2 text-fg transition-colors hover:border-blue hover:text-blue"
          >
            see projects
          </a>
          <a
            href={site.github}
            class="px-2 py-2 text-fg-muted transition-colors hover:text-fg"
          >
            github →
          </a>
        </div>
      </div>

      <div class="min-w-0 overflow-hidden rounded-xl border border-editor-line bg-editor shadow-2xl shadow-black/30 ring-1 ring-black/5">
        <div class="flex items-end border-b border-editor-line bg-editor-bar font-mono text-xs text-editor-gutter">
          <span class="border-r border-editor-line border-t-2 border-t-[#8ba4b0] bg-editor px-4 py-2 text-editor-fg">
            konami.ts
          </span>
          <span class="border-r border-editor-line px-4 py-2">Base.astro</span>
          <span class="ml-auto hidden px-4 py-2 sm:block">src/lib</span>
        </div>
        <HeroCode client:load lines={lines} />
      </div>
    </div>
  </section>

  <div class="mx-auto max-w-5xl space-y-20 px-4 sm:px-6">
    <section>
      <SectionHeading
        title="Featured projects"
        href="/projects"
        linkLabel="all projects"
      />
      <div class="grid gap-4 sm:grid-cols-2">
        {featured.map((project) => (
          <ProjectCard project={project} />
        ))}
      </div>
    </section>

    <div class="grid gap-16 lg:grid-cols-[1.6fr_1fr]">
      <section>
        <SectionHeading
          title="Latest writing"
          href="/blog"
          linkLabel="all posts"
        />
        <PostList posts={posts} />
      </section>

      <section>
        <SectionHeading title="git log --since=summer" />
        <ol class="space-y-4 border-l border-line pl-5 font-mono text-sm">
          {now.map(({ when, what }) => (
            <li class="relative">
              <span
                class="absolute top-1.5 -left-[25px] size-2 rounded-full bg-blue ring-4 ring-bg"
                aria-hidden="true"
              />
              <span class="block text-xs text-comment">{when}</span>
              <span class="text-fg-muted">{what}</span>
            </li>
          ))}
        </ol>
      </section>
    </div>
  </div>
</Base>

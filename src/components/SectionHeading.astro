---
interface Props {
  title: string;
  href?: string;
  linkLabel?: string;
}

const { title, href, linkLabel } = Astro.props;
---

<div class="mb-6 flex items-baseline justify-between gap-4">
  <h2 class="font-mono text-lg font-semibold tracking-tight text-fg before:text-comment before:content-['##_']">
    {title}
  </h2>
  {href && (
    <a
      href={href}
      class="font-mono text-xs text-fg-muted transition-colors hover:text-blue"
    >
      {linkLabel} →
    </a>
  )}
</div>

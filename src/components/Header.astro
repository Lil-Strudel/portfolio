---
import { Image } from "astro:assets";
import { site } from "../data/site";
import avatar from "../assets/avatar.jpg";

const links = [
  { href: "/about", label: "about" },
  { href: "/projects", label: "projects" },
  { href: "/blog", label: "blog" },
];

const path = Astro.url.pathname;
const isActive = (href: string) => path === href || path.startsWith(`${href}/`);
---

<header class="sticky top-0 z-40 border-b border-line/70 bg-bg/80 backdrop-blur-md">
  <nav
    class="mx-auto flex h-14 max-w-5xl items-center gap-2 px-4 font-mono text-sm sm:gap-6 sm:px-6"
    aria-label="Main"
  >
    <a
      href="/"
      class="group mr-auto flex items-center gap-2.5"
      aria-label="Home"
    >
      <Image
        src={avatar}
        alt=""
        width={26}
        height={26}
        densities={[1, 2]}
        class="rounded-full"
      />
      <span class="hidden text-fg-muted transition-colors group-hover:text-fg sm:inline">
        ~/<span class="text-fg">strudel</span>
      </span>
    </a>
    <ul class="flex items-center gap-1 sm:gap-2">
      {links.map(({ href, label }) => (
        <li>
          <a
            href={href}
            aria-current={isActive(href) ? "page" : undefined}
            class="inline-flex rounded-md px-2 py-1 text-fg-muted transition-colors before:text-comment before:content-[':'] hover:text-fg aria-[current=page]:text-blue"
          >
            {label}
          </a>
        </li>
      ))}
    </ul>
    <div class="flex items-center gap-1 border-l border-line pl-2 sm:pl-4">
      <a
        href={site.github}
        class="rounded-md p-1.5 text-fg-muted transition-colors hover:text-fg"
        aria-label="GitHub"
      >
        <svg
          viewBox="0 0 24 24"
          class="size-[18px]"
          fill="currentColor"
          aria-hidden="true"
        >
          <path d="M12 .5a11.5 11.5 0 0 0-3.64 22.41c.58.1.79-.25.79-.56v-2c-3.2.7-3.88-1.37-3.88-1.37-.52-1.33-1.28-1.69-1.28-1.69-1.05-.71.08-.7.08-.7 1.16.08 1.77 1.19 1.77 1.19 1.03 1.77 2.7 1.26 3.36.96.1-.75.4-1.26.73-1.55-2.56-.29-5.25-1.28-5.25-5.68 0-1.26.45-2.28 1.19-3.09-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.17 1.18a11 11 0 0 1 5.77 0c2.2-1.49 3.17-1.18 3.17-1.18.63 1.59.23 2.76.11 3.05.74.81 1.19 1.83 1.19 3.09 0 4.41-2.7 5.38-5.26 5.67.41.36.78 1.06.78 2.14v3.17c0 .31.21.67.8.56A11.5 11.5 0 0 0 12 .5Z"></path>
        </svg>
      </a>
      <button
        type="button"
        id="theme-toggle"
        class="rounded-md p-1.5 text-fg-muted transition-colors hover:text-fg"
        aria-label="Toggle dark mode"
      >
        <svg
          viewBox="0 0 24 24"
          class="size-[18px] dark:hidden"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          aria-hidden="true"
        >
          <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8Z"></path>
        </svg>
        <svg
          viewBox="0 0 24 24"
          class="hidden size-[18px] dark:block"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          aria-hidden="true"
        >
          <circle cx="12" cy="12" r="4"></circle>
          <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path>
        </svg>
      </button>
    </div>
  </nav>
</header>

<script>
  const root = document.documentElement;

  document.getElementById("theme-toggle")?.addEventListener("click", () => {
    const next = root.dataset.theme === "dark" ? "light" : "dark";
    root.dataset.theme = next;
    try {
      localStorage.setItem("theme", next);
    } catch {}
  });
</script>

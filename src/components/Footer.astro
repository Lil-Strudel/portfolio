---
import { site } from "../data/site";
---

<footer class="mt-24 border-t border-line/70 bg-bg-alt">
  <div class="mx-auto flex max-w-5xl flex-col gap-3 px-4 py-6 font-mono text-xs text-comment sm:flex-row sm:items-center sm:justify-between sm:px-6">
    <p>
      <span class="text-green">✓</span> built with Astro, Svelte &amp; Tailwind
      ·{" "}
      <a
        href={`${site.github}/portfolio`}
        class="underline decoration-line underline-offset-4 transition-colors hover:text-fg"
      >
        source
      </a>
    </p>
    <ul class="flex gap-4">
      <li>
        <a href={site.github} class="transition-colors hover:text-fg">
          github
        </a>
      </li>
      <li>
        <a href="/rss.xml" class="transition-colors hover:text-fg">
          rss
        </a>
      </li>
      <li>
        <span>
          © {new Date().getFullYear()} {site.name}
        </span>
      </li>
    </ul>
  </div>
</footer>
